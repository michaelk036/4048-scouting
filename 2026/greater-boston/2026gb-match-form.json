[
  {
    "type": "header",
    "label": "Match Scouting Form"
  },
  {
    "type": "spacer"
  },
  {
    "type": "subheader",
    "label": "Where is your robot at the begining of the match?"
  },
  {
    "type": "image",
    "image_id": "starting-position"
  },
  {
    "type": "checkbox",
    "label": "Depot Side",
    "id": "depotSide"
  },
  {
    "type": "checkbox",
    "label": "Mid",
    "id": "mid"
  },
  {
    "type": "checkbox",
    "label": "Outpost Side",
    "id": "outpostSide"
  },
  {
    "type": "checkbox",
    "label": "Not Present",
    "id": "notPresent"
  },
  {
    "type": "spacer"
  },
  {
    "type": "slider",
    "label": "What percentage of the total fuel scored by this alliance did your robot score? PLEASE CONSULT WITH THE TWO OTHER PEOPLE SCOUTING YOUR ALLIANCE. The total between the 3 of you MUST add up to 100.",
    "id": "fuelContributionPercent",
    "options": {
      "min": 0,
      "max": 100,
      "step": 5
    },
    "variant": "standard"
  },
  {
    "type": "slider",
    "label": "How many points did your alliance receive this match?",
    "id": "allianceScore",
    "options": {
      "min": 0,
      "max": 500,
      "step": 1
    },
    "variant": "standard"
  },
  {
    "type": "checkbox",
    "label": "Did they intake from the ground?",
    "id": "gndIntake"
  },
  {
    "type": "checkbox",
    "label": "Did they intake from the outpost?",
    "id": "outpostIntake"
  },
  {
    "type": "checkbox",
    "label": "Did they go over the bump?",
    "id": "overBump"
  },
  {
    "type": "checkbox",
    "label": "Did they go under the trench?",
    "id": "underTrench"
  },
  {
    "type": "checkbox",
    "label": "Did they shuttle fuel?",
    "id": "shuttle"
  },
  {
    "type": "checkbox",
    "label": "Did they play defense?",
    "id": "defense"
  },
  {
    "type": "checkbox",
    "label": "Did they climb in auto?",
    "id": "autoClimb"
  },
  {
    "type": "spacer"
  },
  {
    "type": "subheader",
    "label": "Endgame"
  },
  {
    "type": "multiselect",
    "label": "State robot status at the end of the match:",
    "options": [
      "Not Climbing",
      "Level 1",
      "Level 2",
      "Level 3"
    ],
    "id": "teleopClimb"
  },
  {
    "type": "spacer"
  },
  {
    "type": "textblock",
    "label": "Comments/Notes",
    "id": "comment"
  },
  {
    "type": "derived",
    "formula": "multiselect(teleopClimb, 'Not Climbing', 0, 'Level 1', 10, 'Level 2', 20, 'Level 3', 30)",
    "id": "endGamePoints"
  },
  {
    "type": "derived",
    "formula": "allianceScore - endGamePoints",
    "id": "allianceFuel"
  },
  {
    "type": "derived",
    "formula": "allianceFuel * fuelContributionPercent",
    "id": "contributedFuel"
  },
  {
    "type": "derived",
    "formula": "(allianceScore / 3) - contributedFuel",
    "id": "fuelDeviation"
  }
]